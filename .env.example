# Telegram
BOT_TOKEN=Insert:token
BOT_USERNAME=ddcocbot
# Supergroup managed by the bot (negative ID, e.g. -1001234567890)
GROUP_ID=Insert:group_id
# Telegram user ID allowed to run /register, /drop and /dump
OWNER_TELEGRAM_ID=Insert:telegram_user_id

# PostgreSQL. docker compose reads POSTGRES_PASSWORD from this file.
POSTGRES_PASSWORD=Insert:password
DATABASE_URL="postgresql://ddcocbot:password@localhost:5432/ddcocbot"

# Clash of Clans API (https://developer.clashofclans.com). The key is bound to the server IP.
COC_API_URL=https://api.clashofclans.com/v1
COC_API_TOKEN=Insert:token
COC_CLAN_TAG=Insert:tag
